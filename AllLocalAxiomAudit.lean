import all Solution
meta import Lean.Util.CollectAxioms

@[expose] public section

open Lean Elab Command

set_option maxHeartbeats 0

/- Audit every declaration in the project namespace, including private helpers,
against the explicit permitted standard axioms. -/
run_cmd do
  let env := (← getEnv).setExporting false
  let mut checked : Nat := 0
  for (name, _) in env.constants.toList do
    let localModule := match env.getModuleIdxFor? name with
      | some idx => (`GinibrePoincare).isPrefixOf env.header.moduleNames[idx.toNat]! ||
          env.header.moduleNames[idx.toNat]! == `Solution
      | none => false
    if localModule then
      let axioms ← Lean.collectAxioms name
      for ax in axioms do
        unless ax == `propext || ax == `Classical.choice || ax == `Quot.sound do
          throwError "Forbidden axiom {ax} in project declaration {name}"
      checked := checked + 1
  logInfo m!"All-local axiom audit passed: {checked} project declarations; only propext, Classical.choice, Quot.sound."
