"GinibrePoincare.ginibreMeasure" -> "GinibrePoincare.matrixGaussianMeasure" [style=invis];
"GinibrePoincare.matrixGaussianMeasure" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi_of_entries" [style=invis];
"GinibrePoincare.matrixSpectralLift_finite_overlap_lsi_of_entries" -> "GinibrePoincare.matrixSpectralOverlapEnergy" [style=invis];
"GinibrePoincare.matrixSpectralOverlapEnergy" -> "GinibrePoincare.squareEntropy" [style=invis];
