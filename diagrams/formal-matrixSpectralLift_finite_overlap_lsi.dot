"GinibrePoincare.matrixSpectralLift_finite_overlap_lsi_of_entries" [label="matrixSpectralLift_finite_overlap_lsi_of_entries"];
"GinibrePoincare.matrixSpectralOverlapEnergy" [label="matrixSpectralOverlapEnergy"];
"GinibrePoincare.squareEntropy" [label="squareEntropy"];
"GinibrePoincare.Configuration" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#b45309", tooltip="type"];
"GinibrePoincare.GinibreMatrixCoordinates" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#7e22ce", tooltip="both"];
"GinibrePoincare.ginibreMatrixMeasurableSpace" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#7e22ce", tooltip="both"];
"GinibrePoincare.ginibreMeasure" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#7e22ce", tooltip="both"];
"GinibrePoincare.matrixGaussianMeasure" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#7e22ce", tooltip="both"];
"GinibrePoincare.matrixSpectralLift_finite_overlap_lsi_of_entries" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#2563eb", tooltip="value"];
"GinibrePoincare.matrixSpectralOverlapEnergy" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#7e22ce", tooltip="both"];
"GinibrePoincare.squareEntropy" -> "GinibrePoincare.matrixSpectralLift_finite_overlap_lsi" [color="#b45309", tooltip="type"];
