digraph dependencies {
rankdir=LR;
graph [bgcolor="transparent", pad="0.3", nodesep="0.3"];
node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#64748b", fontname="sans-serif", fontsize=12, margin="0.18,0.12"];
edge [color="#64748b", arrowsize=0.7];
ComplexGaussianHermite [label="Complex Gaussian and Hermite\nanalysis"];
GaussianLSI [label="Gaussian log-Sobolev and\nentropy"];
PolynomialRadial [label="Polynomial, radial and\nequilibrium sectors"];
StochasticDynamics [label="Ginibre stochastic dynamics"];
WeakSobolev [label="Weak Sobolev domains and\ncollision capacity"];
StochasticCalculus [label="Stochastic calculus\nfoundations", fillcolor="#dbeafe", color="#2563eb", penwidth=2];
ComplexGaussianHermite -> StochasticCalculus;
GaussianLSI -> StochasticCalculus;
PolynomialRadial -> StochasticCalculus;
StochasticDynamics -> StochasticCalculus;
WeakSobolev -> StochasticCalculus;
}
